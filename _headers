# Cloudflare Pages - Custom HTTP Headers
# https://developers.cloudflare.com/pages/configuration/headers/

# JSON data files: always revalidate (updated by GitHub Actions weekly)
/data/*.json
  Cache-Control: no-cache, must-revalidate

# JavaScript and CSS: cache with revalidation
/*.js
  Cache-Control: public, max-age=3600, must-revalidate

/*.css
  Cache-Control: public, max-age=3600, must-revalidate

# HTML pages: always revalidate
/*.html
  Cache-Control: no-cache, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://site.api.espn.com https://sports.core.api.espn.com; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'

# Root (index.html)
/
  Cache-Control: no-cache, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://site.api.espn.com https://sports.core.api.espn.com; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'
